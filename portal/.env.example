# Copy of the settings the portal needs. start.bat creates .env.local from this file and asks for the database address.

# PostgreSQL connection string (Neon, Supabase, or any Postgres). The portal keeps its tables in its own "portal" schema.
DATABASE_URL=

# Where the CRM website runs (start.bat starts it on this port)
NEXT_PUBLIC_CRM_URL=http://localhost:3200

# Signs the login cookie. start.bat fills this in with a random value if it is empty.
AUTH_SECRET=

# 0 = real sign-in only (recommended). 1 = shows demo shortcuts.
DEMO_MODE=0

# Photo storage on Backblaze B2 (private bucket, S3 compatible). Leave empty to run without photo uploads.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_ENDPOINT=
B2_REGION=
