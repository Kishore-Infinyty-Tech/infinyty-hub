.env
.env.*
!.env.example

# Installed packages and build output (start.bat recreates them)
node_modules/
.next/
.venv/
__pycache__/
*.pyc
*.tsbuildinfo

# Local data and logs
backend/media/
*.log

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Word and PDF documents in the CRM copy are not code
crm-website/*.docx
crm-website/*.pdf
